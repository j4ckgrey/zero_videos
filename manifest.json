{
  "id": "rewind.conduit",
  "name": "The Conduit",
  "version": "2.0.0",
  "description": "yt-dlp online video for Rewind — homepage trailers, the Videos library (YouTube search + playback), and YouTube Music. Provisions the yt-dlp binary on the server at install. Local videos/music libraries do not need this addon.",
  "resources": ["catalog", "meta", "stream", "search"],
  "types": ["video", "channel", "music", "track", "album", "artist", "playlist"],
  "idPrefixes": ["yt:", "UC"],
  "rewind": {
    "kind": "videos",
    "sdk": 1,
    "repo": "j4ckgrey/rewind_videos",
    "branch": "main",
    "bundlePath": "dist/index.mjs",
    "bundleUrl": "https://raw.githubusercontent.com/j4ckgrey/rewind_videos/release/dist/index.mjs",
    "tabs": [],
    "configKeys": [],
    "features": ["trailers", "videos", "ytmusic"],
    "install": { "provisions": ["yt-dlp-binary"] }
  }
}
