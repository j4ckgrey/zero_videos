{
  "id": "zero.conduit",
  "name": "Conduit",
  "version": "2.0.2",
  "description": "yt-dlp online video for Zero Media — content, metadata and artwork for videos and music (YouTube search + playback, YouTube Music), plus homepage trailer playback. Provisions the yt-dlp binary on the server at install. Local videos/music libraries do not need this addon.",
  "resources": [
    "catalog",
    "catalogs",
    "meta",
    "stream",
    "search",
    "artwork"
  ],
  "types": [
    "video",
    "channel",
    "trailer",
    "music",
    "track",
    "album",
    "artist",
    "playlist",
    "genre"
  ],
  "idPrefixes": [
    "yt:",
    "yt_id:",
    "yb:",
    "UC",
    "https://www.youtube.com/",
    "https://youtube.com/",
    "https://m.youtube.com/",
    "https://music.youtube.com/",
    "https://youtu.be/"
  ],
  "provides": {
    "content": [
      "videos",
      "music"
    ],
    "metadata": [
      "videos",
      "music"
    ],
    "artwork": [
      "videos",
      "music"
    ]
  },
  "zero": {
    "kind": "videos",
    "sdk": 3,
    "repo": "j4ckgrey/zero_videos",
    "branch": "main",
    "bundlePath": "dist/index.mjs",
    "bundleUrl": "https://raw.githubusercontent.com/j4ckgrey/zero_videos/release/dist/index.mjs",
    "settings": [
      {
        "key": "music_enabled",
        "type": "toggle",
        "label": "YouTube Music",
        "description": "Music spaces, search and playback from YouTube Music.",
        "default": true
      },
      {
        "key": "videos_enabled",
        "type": "toggle",
        "label": "YouTube videos",
        "description": "Video spaces, channels, search and playback from YouTube.",
        "default": true
      },
      {
        "key": "youtubio_url",
        "type": "url",
        "label": "YouTubio catalogue",
        "description": "Optional. A Stremio-style YouTube catalogue (its manifest URL) for the rows on the videos home.",
        "placeholder": "https://…/manifest.json"
      },
      {
        "key": "youtube_cookies",
        "type": "secret",
        "multiline": true,
        "label": "YouTube cookies (cookies.txt)",
        "description": "From a throwaway Google account. YouTube asks datacenter IPs to “confirm you’re not a bot”; signed-in cookies get past it. Paste the whole cookies.txt."
      }
    ],
    "actions": [
      {
        "id": "status"
      },
      {
        "id": "rt-list"
      },
      {
        "id": "rt-toggle"
      },
      {
        "id": "rt-discover"
      },
      {
        "id": "update-ytdlp"
      }
    ],
    "ui": {
      "tabs": [
        {
          "id": "youtube",
          "label": "YouTube",
          "icon": "film",
          "group": "content",
          "description": "YouTube videos, YouTube Music and the Rotten Tomatoes trailer rows, through yt-dlp.",
          "sections": [
            {
              "kind": "status",
              "id": "status",
              "title": "Status",
              "source": "status",
              "buttons": [
                {
                  "action": "update-ytdlp",
                  "label": "Update yt-dlp"
                }
              ]
            },
            {
              "kind": "form",
              "id": "features",
              "title": "What Conduit serves",
              "fields": [
                "music_enabled",
                "videos_enabled",
                "youtubio_url"
              ]
            },
            {
              "kind": "form",
              "id": "cookies",
              "title": "Sign-in cookies",
              "fields": [
                "youtube_cookies"
              ]
            },
            {
              "kind": "table",
              "id": "rt",
              "title": "Rotten Tomatoes trailers",
              "description": "Each enabled playlist becomes a trailer row on the home screen.",
              "rows": "rt-list",
              "columns": [
                {
                  "key": "title",
                  "label": "Playlist"
                },
                {
                  "key": "videos",
                  "label": "Videos",
                  "format": "number"
                },
                {
                  "key": "enabled",
                  "label": "Shown",
                  "format": "bool",
                  "action": "rt-toggle"
                }
              ],
              "empty": "No playlists yet — press Discover playlists.",
              "buttons": [
                {
                  "action": "rt-discover",
                  "label": "Discover playlists"
                }
              ]
            }
          ]
        }
      ]
    },
    "spaces": [
      {
        "id": "music",
        "name": {
          "en": "Music",
          "de": "Musik",
          "fr": "Musique",
          "it": "Musica",
          "es": "Música",
          "nl": "Muziek",
          "pt": "Música",
          "zh": "音乐"
        },
        "icon": "music",
        "layout": "music",
        "types": [
          "track",
          "album",
          "artist",
          "playlist",
          "genre"
        ]
      },
      {
        "id": "videos",
        "name": {
          "en": "Videos",
          "de": "Videos",
          "fr": "Vidéos",
          "it": "Video",
          "es": "Vídeos",
          "nl": "Video's",
          "pt": "Vídeos",
          "zh": "视频"
        },
        "icon": "video",
        "layout": "video",
        "types": [
          "video",
          "channel",
          "playlist"
        ]
      }
    ]
  },
  "catalogs": [
    {
      "id": "made-for-you",
      "type": "track",
      "name": "Made for you",
      "names": {
        "en": "Made for you",
