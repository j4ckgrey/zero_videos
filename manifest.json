      ]
    },
    {
      "id": "popular",
      "type": "artist",
      "name": "Popular artists",
      "names": {
        "en": "Popular artists",
        "de": "Beliebte Künstler",
        "es": "Artistas populares",
        "fr": "Artistes populaires",
        "it": "Artisti popolari",
        "nl": "Populaire artiesten",
        "pt": "Artistas populares",
        "zh": "热门艺人"
